      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "institucion": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::institucion.institucion"
    },
    "eje_estrategicos": {
      "type": "relation",
      "relation": "manyToMany",
