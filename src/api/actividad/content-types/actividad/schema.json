{
  "kind": "collectionType",
  "collectionName": "actividads",
  "info": {
    "singularName": "actividad",
    "pluralName": "actividads",
    "displayName": "Actividad"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Titulo": {
      "type": "string",
      "minLength": 4,
      "maxLength": 200,
      "required": true
    },
    "Inicio": {
      "type": "datetime",
      "required": true,
      "default": "2025-07-30T04:00:00.000Z"
    },
    "Fin": {
      "type": "datetime",
      "required": true,
      "default": "2025-07-30T04:00:00.000Z"
    },
    "Descripcion": {
      "type": "text"
    },
    "Ubicacion": {
      "type": "string",
      "required": true
    },
    "Tipo": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "cultural",
        "institucional",
        "lanzamiento"
      ]
    }
  }
}
