{
  "kind": "collectionType",
  "collectionName": "articulos",
  "info": {
    "singularName": "articulo",
    "pluralName": "articulos",
    "displayName": "Articulo"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Portada": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Titulo": {
      "type": "text",
      "required": true,
      "unique": true
    },
    "Content": {
      "type": "blocks"
    },
    "Creacion": {
      "type": "date"
    },
    "autor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::autor.autor"
    },
    "Identificador": {
      "type": "uid",
      "targetField": "Titulo"
    }
  }
}
