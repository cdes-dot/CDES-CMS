{
  "kind": "collectionType",
  "collectionName": "equipo_tecnicos",
  "info": {
    "singularName": "equipo-tecnico",
    "pluralName": "equipo-tecnicos",
    "displayName": "Equipo Tecnico"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Nombre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50,
      "required": true
    },
    "Apellidos": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "required": true
    },
    "Portada": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "puesto": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::puesto.puesto",
      "inversedBy": "equipo_tecnicos"
    },
    "Contacto": {
      "type": "email",
      "required": true,
      "unique": true
    }
  }
}
