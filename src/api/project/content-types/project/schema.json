{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Titulo": {
      "type": "string",
      "required": true
    },
    "Objetivos": {
      "type": "text",
      "required": true
    },
    "Alcance": {
      "type": "text"
    },
    "Instituciones": {
      "type": "json"
    },
    "Imagen": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Enlace": {
      "type": "string"
    },
    "Categoria": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Desarrollo Urbano",
        "Medio Ambiente",
        "Educación",
        "Transporte",
        "Infraestructura",
        "Social",
        "Económico",
        "Cultural"
      ]
    },
    "Estado": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Activo",
        "En planificación",
        "Completado",
        "Pausado",
        "Cancelado"
      ]
    },
    "FechaStart": {
      "type": "date",
      "required": true
    },
    "FechaEstimacionFinal": {
      "type": "date",
      "required": true
    },
    "presupuesto": {
      "type": "integer"
    },
    "ubicacion": {
      "type": "string",
      "required": true
    },
    "porcentajeAvance": {
      "type": "integer",
      "default": 0,
      "max": 100
    },
    "descripcion": {
      "type": "richtext"
    },
    "Logo": {
      "type": "component",
      "component": "shared.logo",
      "repeatable": true
    }
  }
}
