{
  "kind": "collectionType",
  "collectionName": "proyectos",
  "info": {
    "singularName": "proyecto",
    "pluralName": "proyectos",
    "displayName": "Proyecto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Titulo": {
      "type": "string",
      "required": true
    },
    "Portada": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Descripcion": {
      "type": "blocks",
      "required": true
    },
    "Alcance": {
      "type": "text",
      "required": true
    },
    "Objetivos": {
      "type": "blocks"
    },
    "instituciones": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::institucion.institucion"
    },
    "Completado": {
      "type": "boolean"
    }
  }
}
