{
  "kind": "collectionType",
  "collectionName": "proyectos",
  "info": {
    "singularName": "proyecto",
    "pluralName": "proyectos",
    "displayName": "Proyecto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Titulo": {
      "type": "string",
      "required": true
    },
    "Portada": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Descripcion": {
      "type": "blocks",
      "required": true
    },
    "Objetivos": {
      "type": "blocks"
    },
    "eje_estrategico": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::eje-estrategico.eje-estrategico",
      "required": true
    }
  }
}
